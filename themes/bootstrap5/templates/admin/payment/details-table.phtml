<table class="table table-striped">
  <tr>
    <th><?=$this->transEsc('ID')?></th>
    <td><?=$this->escapeHtml($paymentEntity->getId())?></td>
  </tr>
  <tr>
    <th><?=$this->transEsc('Local Identifier')?></th>
    <td><?=$this->escapeHtml($paymentEntity->getLocalIdentifier())?></td>
  </tr>
  <tr>
    <th><?=$this->transEsc('Remote Identifier')?></th>
    <td><?=$this->escapeHtml($paymentEntity->getRemoteIdentifier())?></td>
  </tr>
  <tr>
    <th><?=$this->transEsc('ILS')?></th>
    <td><?=$this->escapeHtml($paymentEntity->getSourceIls())?></td>
  </tr>
  <tr>
    <th><?=$this->transEsc('Username')?></th>
    <td><?=$this->escapeHtml($paymentEntity->getCatUsername())?></td>
