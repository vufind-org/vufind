<?php
  $form = $this->form;
  $form->prepare();

  $title = $form->getTitle();
  $title = !empty($title) ? $this->translate($title) : null;

  $formUrl = $this->url($form->getFormActionRoute(), ['id' => $this->formId]);

  $help = $form->getHelp();
  $helpPreHtml = isset($help['pre']) ? $form->getDisplayString($help['pre'], false) : null;
  $helpPostHtml = isset($help['post']) ? $form->getDisplayString($help['post'], false) : null;
?>
<?php if (!$this->inLightbox): ?><div class="feedback-content"><?php endif; ?>
<?php if ($title): ?>
  <?=$this->component('page-title', ['title' => $title, 'level' => 1])?>
<?php endif; ?>
<?=$this->flashmessages()?>

<form class="dynamic-form" method="post" action="<?=$this->url($form->getFormActionRoute(), ['id' => $this->formId])?>">
  <?php if ($helpPreHtml): ?>
    <div class="form-group">
      <div class="form-info pre">
        <?=$helpPreHtml?>
      </div>
    </div>
  <?php endif ?>

  <?php $currentGroup = null; ?>
  <?php foreach ($form->getFormElementConfig() as $el): ?>
    <?php
      // Group form elements into field sets
      $handleGroup = $group = null;
      if (isset($el['group']) && !empty($el['group'])) {
          $group = $el['group'];
      }
      if ($group && $currentGroup === null) {
          $handleGroup = 'open';
          $currentGroup = $group;
      } elseif ($currentGroup && !$group) {
          $handleGroup = 'close';
          $currentGroup = null;
      } elseif ($currentGroup !== $group) {
          $handleGroup = 'openAndClose';
          $currentGroup = $group;
      }
      $elementHelpPreHtml = $form->getDisplayString($el['help']['pre'] ?? '');
      $elementHelpPostHtml = $form->getDisplayString($el['help']['post'] ?? '');

      $elConf = $this->form->getHtmlElementConfig($el);
    ?>

    <?php if (in_array($handleGroup, ['close', 'openAndClose'])): ?>
      </div>
    <?php endif ?>
    <?php if (in_array($handleGroup, ['open', 'openAndClose'])): ?>
      <?php if (in_array($el['type'], ['checkbox', 'radio'])): ?>
        <div class="field-set" role="group"<?= !empty($el['label']) ? ' aria-labelledby="' . $this->escapeHtmlAttr($elConf['id']) . '"' : ''?>>
      <?php else: ?>
        <div class="field-set">
      <?php endif ?>
    <?php endif ?>

    <div class="form-group <?= $el['type'] ?> group-<?=$this->escapeHtmlAttr($el['name'])?>">
    <?php if (!empty($elementHelpPreHtml)): ?>
      <p class="info pre"><?=$elementHelpPreHtml?></p>
    <?php endif ?>
    <?php if ($el['type'] !== 'submit'): ?>
      <?php if ($el['label']): ?>
        <?php
          $required = $el['required'] ?? false;
          $requireOne = $el['requireOne'] ?? false;
        ?>
        <?php if (in_array($el['type'], ['checkbox', 'radio'])): ?>
          <p id="<?=$this->escapeHtmlAttr($elConf['id'])?>" class="form-label radio-label<?=$required && !$requireOne ? ' required' : ''?><?=$requireOne ? ' require-one' : ''?>"><?=$this->transEsc($el['label'])?>:
            <?php if ($required): ?>
              <span class="required-notice"><?=$this->transEsc('form_required_notice') ?></span>
            <?php endif; ?>
          </p>
        <?php elseif ('hidden' !== $el['type']): ?>
          <label for="<?= $this->escapeHtmlAttr($elConf['id']) ?>" class="form-label<?= $required ? ' required' : '' ?>">
            <?= $this->transEsc($el['label']) ?>:
            <?php if ($required): ?>
              <span class="required-notice"><?=$this->transEsc('form_required_notice') ?></span>
            <?php endif; ?>
          </label>
        <?php endif ?>
      <?php endif ?>
    <?php else: /* submit element */ ?>
      <?php if ($helpPostHtml): ?>
        <div class="form-info post">
          <?=$helpPostHtml?>
        </div>
      <?php endif ?>
      <?=$this->captcha()->html($this->useCaptcha) ?>
    <?php endif ?>

    <?php
      // text|textarea|date|email|url|select|radio|checkbox|hidden
      $messages = $el['messages'] ?? null;
      $attrs = $this->htmlAttributes($elConf['attributes']);
      switch ($elConf['type']) {
        case 'text':
        case 'date':
        case 'email':
        case 'url':
        case 'hidden':
        case 'submit':
          echo "<input$attrs>";
          break;
        case 'textarea':
          echo "<textarea$attrs>" . $this->escapeHtml($elConf['value'] ?? '') . '</textarea>';
          break;
        case 'select':
          echo "<select$attrs>";
          if ($elConf['optionGroups']) {
            foreach ($elConf['optionGroups'] as $group) {
              echo '<optgroup label="' . $this->escapeHtmlAttr($group['label'] ?? '') . '">';
              foreach ($group['options'] ?? [] as $option) {
                echo '<option value="' . $this->escapeHtmlAttr($option['value'] ?? '') . '"'
                  . (($option['selected'] ?? false) ? ' selected' : '')
                  . '>'
                  . $this->transEsc($option['label'] ?? '')
                  . '</option>';
              }
            }
          } else {
            foreach ($elConf['options'] ?? [] as $option) {
              echo '<option value="' . $this->escapeHtmlAttr($option['value'] ?? '') . '"'
                . (($option['disabled'] ?? false) ? ' disabled' : '')
                . (($option['selected'] ?? false) ? ' selected' : '')
                . '>'
                . $this->transEsc($option['label'] ?? '')
                . '</option>';
            }
          }
          echo '</select>';
          break;
        case 'radio':
          $i = 1;
          foreach ($elConf['options'] as $option) {
            $optAttrs = $elConf['attributes'];
            $optAttrs['type'] = 'radio';
            $optAttrs['id'] .= '_' . $i;
            $optAttrs['value'] = $option['value'];
            if ($option['selected']) {
              $optAttrs['checked'] = null;
            }
            $attrs = $this->htmlAttributes($optAttrs);
            echo '<label>';
            echo "<input$attrs>";
            echo $this->transEsc($option['label'] ?? '');
            echo '</label>';
            ++$i;
          }
          break;
        case 'checkbox':
          $i = 1;
          foreach ($elConf['options'] as $option) {
            $optAttrs = $elConf['attributes'];
            $optAttrs['type'] = 'checkbox';
            $optAttrs['id'] .= '_' . $i;
            $optAttrs['name'] .= '[]';
            $optAttrs['value'] = $option['value'];
            if ($option['selected']) {
              $optAttrs['checked'] = null;
            }
            $attrs = $this->htmlAttributes($optAttrs);
            echo '<label>';
            echo "<input$attrs>";
            echo $this->transEsc($option['label'] ?? '');
            echo '</label>';
            ++$i;
          }
          break;
      }
    ?>

    <?php if ($messages): ?>
      <ul>
        <?php foreach ($messages as $message): ?>
          <li><?=$this->escapeHtml($message)?></li>
        <?php endforeach ?>
      </ul>
    <?php endif; ?>

    <?php if (!empty($elementHelpPostHtml)): ?>
      <p class="info post"><?=$elementHelpPostHtml?></p>
    <?php endif ?>
    </div>
  <?php endforeach ?>
</form>
<?php if (!$this->inLightbox): ?></div><?php endif; ?>
