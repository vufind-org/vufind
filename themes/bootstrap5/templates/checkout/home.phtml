<?php
    $this->headTitle($this->translate('checkout_self'));

    $this->jsTranslations()->addStrings([
        'checkout_scan_aim' => 'checkout_scan_aim',
        'checkout_scan_failed' => 'checkout_scan_failed',
        'checkout_scan_start' => 'checkout_scan_start',
        'checkout_scan_starting' => 'checkout_scan_starting',
        'checkout_scan_stop' => 'checkout_scan_stop',
        'checkout_scan_success' => 'checkout_scan_success',
    ]);

    // zxing-js provides the global `ZXing` that checkout-scanner.js needs, so
    // it has to be registered first. @zxing/library rather than
    // @zxing/browser because we squash each frame before decoding it, and
    // @zxing/browser's ready-made loop offers no way in: the hooks it
    // documents for exactly that are statics its own call sites reference on
    // the base class, so a subclass cannot override them.
    $this->assetManager()->appendScriptLink(
        'https://cdn.jsdelivr.net/npm/@zxing/library@0.21.3/umd/index.min.js'
    );
    $this->assetManager()->appendScriptLink('checkout-scanner.js');
?>

<h1><?= $this->transEsc('checkout_item') ?></h1>

<?= $this->flashmessages() ?>

<form id="checkout-form" method="post" action="<?= $this->url('checkout-home') ?>">
  <input type="hidden" name="csrf" value="<?= $this->escapeHtmlAttr($this->auth()->getManager()->getCsrfHash()) ?>">

  <div id="checkout-scanner"<?= $this->barcode ? ' class="typing"' : '' ?>
       data-barcode-pattern="<?= $this->escapeHtmlAttr($this->barcodePattern) ?>">
    <button type="button" class="btn btn-secondary" id="scanner-toggle">
      <?= $this->transEsc('checkout_scan_start') ?>
    </button>

    <?php /* checkout-scanner.js puts the camera's <video> in here. */ ?>
    <div id="scanner-preview"></div>

    <p id="scanner-status" role="status" aria-live="polite"></p>

    <?php
      /* This is the field that carries the barcode either way: a scan fills
         it in, and it posts whether or not it is on screen. It shows when
         the camera cannot be used, or when a barcode came back rejected.
         inputmode rather than type=number, which would add spinners and
         mangle leading zeros. */
    ?>
    <div id="barcode-entry">
      <label class="form-label" for="barcode"><?= $this->transEsc('checkout_barcode') ?></label>
      <input type="text" class="form-control" id="barcode" name="barcode"
             inputmode="numeric" autocomplete="off"
             value="<?= $this->escapeHtmlAttr($this->barcode) ?>">
      <button type="submit" class="btn btn-primary"><?= $this->transEsc('checkout_item') ?></button>
    </div>
  </div>
</form>
