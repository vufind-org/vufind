<?php
  $consentGiven = (bool)$this->cookieConsent()->getConsentInformation();
  $consentConfigJson = json_encode($this->consentConfig);
?>
<div class="cookie-consent-wrapper">
  <div class="cookie-consent js-cookie-consent<?=$consentGiven ? ' hidden' : ' js-loaded'?>" role="region" aria-label="<?=$this->transEscAttr('Cookie Settings')?>" tabindex="-1">
    <?php if (!$consentGiven): ?>
      <?=$this->render('CookieConsent/cookie-consent-overlay.phtml')?>
