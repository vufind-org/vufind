      <?=$this->assetManager()->outputInlineScriptString('document.querySelector(".js-cookie-consent").focus();'); ?>
    <?php else: ?>
      <div class="cookie-consent__overlay">
        <div class="load-indicator">
          <?=$this->icon('spinner') ?> <?=$this->transEsc('loading_ellipsis')?>
        </div>
      </div>
    <?php endif; ?>
  </div>
</div>
<?php echo $this->assetManager()->outputInlineScriptString("window.addEventListener('load', function() { VuFind.cookie.setupConsent($consentConfigJson); });");
