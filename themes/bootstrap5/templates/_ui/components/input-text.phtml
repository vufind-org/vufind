<?php
    /**
     * Component for rendering form input text and label wrapped inside a div element.
     *
     * @param string id             Id to link label element to the input element, if id is omitted,
     *                              default id will be created with "$this->_componentClass-$this->_invocation".
     *                              Appends -lightbox to the default id if rendered in lightbox.
     * @param string class          Class attribute for wrapping div element. Default is "form-group vc-input-text".
     * @param string name           Name attribute for input element.
     * @param string value          Default value for the input element.
     * @param bool   autofocus      Add autofocus to the input element. Default is false.
     * @param string autocomplete   Identifier of the autocomplete setting.
     * @param string label          Label for the input element.
     * @param int    maxlength      Input element max length.
     * @param int    minlength      Input element min length.
     */
    $id = $this->id ?? '';
    if (!$id) {
        $id = trim("$this->_componentClass-$this->_invocation" . ($this->inLightbox ? '-lightbox' : ''));
    }
    $wrapperAttrs = [
        'class' => trim(($this->class ?? 'form-group') . " $this->_componentClass"),
    ];
    $labelAttrs = [
        'class' => 'form-label',
        'for' => $id,
    ];
    $inputAttrs = [
        'type' => 'text',
        'name' => $this->name ?? '',
        'id' => $id,
        'value' => $this->value ?? '',
        'class' => 'form-control',
    ];
    if ($this->autofocus ?? false) {
        $inputAttrs['autofocus'] = '';
    }
    if ($autocomplete = $this->autocomplete ?? false) {
        $inputAttrs['autocomplete'] = $autocomplete;
    }
    if ($maxlength = $this->maxlength ?? false) {
        $inputAttrs['maxlength'] = $maxlength;
    }
    if ($minlength = $this->minlength ?? false) {
        $inputAttrs['minlength'] = $minlength;
    }
?>
<div<?=$this->htmlAttributes($wrapperAttrs);?>>
    <label<?=$this->htmlAttributes($labelAttrs);?>><?=$this->escapeHtml($this->label ?? '')?>:</label>
    <input<?=$this->htmlAttributes($inputAttrs)?>>
</div>
