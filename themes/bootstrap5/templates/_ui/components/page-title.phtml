<?php
  $titleFinal = $this->translate ?? true ? $this->translate($this->title) : $this->title;
  $headerAttrs = [
    'class' => $this->_componentClass,
  ];
  if ($this->inLightbox) {
    $headerAttrs['tabindex'] = '0';
    $headerAttrs['class'] .= ' lightbox-title';
  }
  $level = $this->level ?: 2;
  $tag = "h$level";
?>
<<?=$tag?><?=$this->htmlAttributes($headerAttrs)?>><?=$this->escapeHtml($titleFinal);?></<?=$tag?>>
