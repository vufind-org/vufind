<?php
    /**
     * Component which is a link, but is displayed like a button.
     *
     * - class => Classes for the button. Default is btn btn-default vc-link-button
     * - url => Button link href.
     * - icon => Icon to use for the button. Only class is required.
     * - text => Text to show for the button.
     * - lightbox => Open content in lightbox.
     */
  $buttonAttrs = [
    'class' => trim(($this->class ?? 'btn btn-default') . ' ' . $this->_componentClass),
    'href' => $this->url ?? '',
  ];

  if ($this->lightbox) {
    $buttonAttrs['data-lightbox'] = '';
    // Set role to button if shown in a dialog/popup.
    $buttonAttrs['role'] = 'button';
  }

  $innerText = '';
  if ($this->icon) {
    $innerText .= $this->icon($this->icon, 'icon-link__icon');
    if ($this->text) {
        $innerText .= ' <span class="icon-link__label">';
    }
  }

  $text = $this->text ?? '';

  $innerText .= $this->transEsc($text);
  if ($this->icon) {
     $innerText .= '</span>';
  }

  // Check if button has a translation key for a longer aria label
  $textAria = $text . '_aria_label';
  if (!$this->translationEmpty($textAria)) {
    $buttonAttrs['aria-label'] = $this->transEsc($textAria);
  }
?>
<a<?=$this->htmlAttributes($buttonAttrs)?>><?=$innerText?></a>
