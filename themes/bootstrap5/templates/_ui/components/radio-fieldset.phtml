<?php
  /**
   * Radio form element inside a fieldset for accessibility standards.
   *
   * @param string  $groupName    Name of the radio group
   * @param ?string $displayName  Name to be displayed (default = $groupName)
   * @param array   $values       Array of values (use associative array for setting display names)
   * @param ?string $checkedValue Checked value (default is first value)
   */
  $escGroupNameAttr = $this->escapeHtmlAttr($this->groupName);
  if (array_is_list($this->values)) {
    $this->values = array_combine($this->values, $this->values);
  }
  if (!in_array($this->checkedValue, array_keys($this->values))) {
    $this->checkedValue = array_key_first($this->values);
  }
?>
<fieldset name="<?=$escGroupNameAttr?>_fieldset">
  <legend><?=$this->transEsc($this->displayName ?? $this->groupName)?></legend>
  <div class="form-group">
    <?php foreach ($this->values as $value => $valueDisplayName): ?>
      <?php
      $escValueAttr = $this->escapeHtmlAttr($value);
      ?>
      <div class="form-check">
        <input
            type="radio"
            name="<?=$escGroupNameAttr?>_fieldset[<?=$escGroupNameAttr?>]"
            id="<?=$escGroupNameAttr?>_fieldset[<?=$escValueAttr?>]"
            class="form-check-input"
            value="<?=$escValueAttr?>"
            <?=($this->checkedValue === $value) ? 'checked' : ''?>
        >
        <label for="<?=$escGroupNameAttr?>_fieldset[<?=$escValueAttr?>]">
          <?=$this->transEsc($valueDisplayName, default: $value)?>
        </label>
      </div>
    <?php endforeach; ?>
  </div>
</fieldset>
