<?php
  /**
   * Radio form element inside a fieldset for accessibility standards.
   *
   * @property string  $groupName    Name of the radio group
   * @property ?string $displayName  Name to be displayed (default = $groupName)
   * @property array   $values       Array of values
   * @property ?string $checkedValue Checked value (default is first value)
   */
  $escGroupNameAttr = $this->escapeHtmlAttr($this->groupName);
  if (!in_array($this->checkedValue, $this->values)) {
    $this->checkedValue = $this->values[0] ?? null;
  }
?>
<fieldset name="<?=$escGroupNameAttr?>_fieldset">
  <legend><?=$this->transEsc($this->displayName ?? $this->groupName)?></legend>
  <div class="form-group">
    <?php foreach ($this->values as $value): ?>
      <?php
      $escValueAttr = $this->escapeHtmlAttr($value);
      ?>
      <div class="form-check">
        <input
            type="radio"
            name="<?=$escGroupNameAttr?>_fieldset[<?=$escGroupNameAttr?>]"
            id="<?=$escGroupNameAttr?>_fieldset[<?=$escValueAttr?>]"
            class="form-check-input"
            value="<?=$escValueAttr?>"
            <?=($this->checkedValue === $value) ? 'checked' : ''?>
        >
        <label for="<?=$escGroupNameAttr?>_fieldset[<?=$escValueAttr?>]">
          <?=$this->transEsc($value)?>
        </label>
      </div>
    <?php endforeach; ?>
  </div>
</fieldset>
