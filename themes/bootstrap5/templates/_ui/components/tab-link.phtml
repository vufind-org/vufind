<?php
  /**
   * Tab link component.
   *
   * @property string  $name                 Name of an item, used as a CSS class for the menu item's <a> tag and as a prefix for an item-specific spinner status CSS class name
   * @property string  $label                The text shown as link, will be translated
   * @property ?string $route                Route name used to generate link target - required unless url is set
   * @property ?array  $routeParams          Parameters for dynamic routes (optional)
   * @property ?string $url                  Target url, alternative to route - required unless route is set
   * @property ?string $idPrefix             ID prefix (optional)
   * @property ?string $active               Name of the active item in the menu (optional)
   * @property ?string $requestUri           Request URI (optional)
   * @property ?array  $activeItemParentPath Parent path for the currently active item (optional)
   */

  $url = $this->url ?: $this->url($this->route, $this->routeParams ?? []);
  if (isset($this->active)) {
    $active = $this->active == $this->name;
  } else {
    $active = ($this->requestUri ?? null) === $url || in_array($url, $this->activeItemParentPath ?? []);
  }
?>
<li class="nav-item" role="presentation" id="<?=$this->idPrefix ?? ''?><?=$this->escapeHtmlAttr($this->name)?>" data-tab="<?=$this->escapeHtmlAttr($this->name)?>"><a class="<?=$active ? 'active' : ''?> nav-link" href="<?=$url?>"><?=$this->transEsc($this->label)?></a></li>
