<?php if ($visFacets = $this->recommend->getVisFacets()): ?>
  <?php
    $this->headScript()->appendFile('vendor/chart.js');
    $this->headScript()->appendFile('vendor/nouislider.min.js');
    $this->headLink()->appendStylesheet('vendor/nouislider.min.css');
    $this->headScript()->appendFile('date_range_slider.js');
    $this->headScript()->appendFile('pubdate_vis.js');
    $this->jsConfigs()->add(
        'pub-vis:facet-fields',
        $this->recommend->getFacetFields()
    );
    $this->jsConfigs()->add(
        'pub-vis:search-params',
        $this->recommend->getSearchParams()
    );
    $this->jsConfigs()->add(
        'pub-vis:zooming',
        $this->recommend->getZooming()
    );
    $this->jsConfigs()->add(
        'pub-vis:initially-hide-controls',
        $this->recommend->getInitiallyHideControlsSetting()
    );
  ?>
  <?php foreach ($visFacets as $facetField => $facetRange): ?>
    <?php
      $facetFieldEsc = $this->escapeHtmlAttr($facetField);
    ?>
    <div class="authorbox">
      <form class="datevis-form facet-range-form hidden" name="datevis<?=$facetFieldEsc?>xForm" id="datevis<?=$facetFieldEsc?>xForm" data-name="<?=$facetFieldEsc?>" data-filter-field="daterange[]">
        <?=$this->results->getUrlQuery()->asHiddenFields(['page' => '/./', 'filter' => '/^' . preg_quote($facetField) . ':.*/'])?>
        <input type="hidden" name="daterange[]" value="<?=$facetFieldEsc?>">
        <div class="datevis-label"><strong><?=$this->transEsc($facetRange['label']) ?></strong></div>
        <div class="datevis-chart">
          <canvas id="datevis<?=$facetFieldEsc?>x-canvas"></canvas>
        </div>
        <div class="slider-container" aria-hidden="true"><div id="datevis<?=$facetFieldEsc?>-slider"></div></div>
        <div class="datevis-controls-trigger" id="datevis<?=$facetFieldEsc?>-controls-trigger"></div>
        <div class="datevis-controls collapse" id="datevis<?=$facetFieldEsc?>-controls">
          <div class="datevis-controls-container">
            <div class="datevis-controls-row datevis-input">
              <label id="datevis<?=$facetFieldEsc?>-from-label" for="datevis<?=$facetFieldEsc?>-from">
                <?=$this->transEsc('date_from')?>:
              </label>
              <input type="number" class="datevis-input-from form-control" name="<?=$facetFieldEsc?>from" id="datevis<?=$facetFieldEsc?>-from">
              <label id="datevis<?=$facetFieldEsc?>-to-label" for="datevis<?=$facetFieldEsc?>-to">
                <?=$this->transEsc('date_to')?>:
              </label>
              <input type="number" class="datevis-input-to form-control" name="<?=$facetFieldEsc?>to" id="datevis<?=$facetFieldEsc?>-to">
            </div>
            <div class="datevis-controls-row">
              <input class="btn btn-default submit-button" type="submit" value="<?=$this->transEscAttr('Set')?>">
              <input class="btn btn-default clear-btn" type="button" value="<?=$this->transEscAttr('Clear')?>">
            </div>
          </div>
        </div>
      </form>
    </div>
  <?php endforeach; ?>
  <div id="dateVisColorSettings"><!-- do not delete! used for passing CSS to Javascript --></div>
<?php endif; ?>
