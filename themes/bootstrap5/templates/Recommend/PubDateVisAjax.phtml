<?php if ($visFacets = $this->recommend->getVisFacets()): ?>
  <?php
    $this->headScript()->appendFile('vendor/chart.js');
    $this->headScript()->appendFile('vendor/nouislider.min.js');
    $this->headLink()->appendStylesheet('vendor/nouislider.min.css');
    $this->headScript()->appendFile('date_range_slider.js');
    $this->headScript()->appendFile('pubdate_vis.js');
    $this->jsConfigs()->add(
        'pub-vis:facet-fields',
        $this->recommend->getFacetFields()
    );
    $this->jsConfigs()->add(
        'pub-vis:search-params',
        $this->recommend->getSearchParams()
    );
    $this->jsConfigs()->add(
        'pub-vis:zooming',
        $this->recommend->getZooming()
    );
    $this->jsConfigs()->add(
        'pub-vis:initially-hide-controls',
        $this->recommend->getInitiallyHideControlsSetting()
    );
  ?>
  <?php foreach ($visFacets as $facetField => $facetRange): ?>
    <div class="authorbox">
      <form class="datevis-form facet-range-form hidden" name="datevis<?=$facetField?>xForm" id="datevis<?=$facetField?>xForm" data-name="<?=$this->escapeHtmlAttr($facetField)?>" data-filter-field="daterange[]">
        <?=$this->results->getUrlQuery()->asHiddenFields(['page' => '/./', 'filter' => "/^{$facetField}:.*/"])?>
        <input type="hidden" name="daterange[]" value="<?=$this->escapeHtmlAttr($facetField)?>">
        <div class="datevis-label"><strong><?=$this->transEsc($facetRange['label']) ?></strong></div>
        <div class="datevis-chart">
          <canvas id="datevis<?=$facetField?>x-canvas"></canvas>
        </div>
        <div class="slider-container" aria-hidden="true"><div id="datevis<?=$facetField?>-slider"></div></div>
        <div class="datevis-controls-trigger" id="datevis<?=$facetField?>-controls-trigger"></div>
        <div class="datevis-controls collapse" id="datevis<?=$facetField?>-controls">
          <div class="datevis-controls-container">
            <label id="datevis<?=$facetField?>-from-label" for="datevis<?=$facetField?>-from">
              <?=$this->transEsc('date_from')?>:
            </label>
            <input type="number" class="form-control" name="<?=$facetField?>from" id="datevis<?=$facetField?>-from">
            <label id="datevis<?=$facetField?>-to-label" for="datevis<?=$facetField?>-to">
              <?=$this->transEsc('date_to')?>:
            </label>
            <input type="number" class="form-control" name="<?=$facetField?>to" id="datevis<?=$facetField?>-to">
            <input class="btn btn-default submit-button" type="submit" value="<?=$this->transEscAttr('Set')?>">
            <input class="btn btn-default clear-btn" type="button" value="<?=$this->transEscAttr('Clear')?>">
          </div>
        </div>
      </form>
    </div>
  <?php endforeach; ?>
  <div id="dateVisColorSettings"><!-- do not delete! used for passing CSS to Javascript --></div>
<?php endif; ?>
