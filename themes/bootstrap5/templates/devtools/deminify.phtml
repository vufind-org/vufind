<?php
    $this->headTitle('Deminifier');
    $this->breadcrumbs()->set('Development Tools', $this->url('devtools-home'))
      ->add('Deminifier', active: true);
?>

<h1>Deminifier</h1>

<?php if (empty($min)): ?>
  <form method='POST'>
    <div class="form-group">
      <label for="min-text">Minified text:</label>
      <textarea class="form-control" id="min-text" name="min" rows="6"></textarea>
    </div>
    <input class="btn btn-primary" type="submit">
  </form>
<?php else: ?>
  <h2>Minified Object</h2>
  <pre><?=$this->escapeHtml(print_r($min, true))?></pre>
<?php endif; ?>

<?php if (isset($results)): ?>
  <h2>Results Object</h2>
  <p>Class: <?=$this->escapeHtml($results::class)?></p>
<?php endif; ?>

<?php if (isset($query)): ?>
  <h2>Query Object</h2>
  <pre><?=$this->escapeHtml(print_r($query, true))?></pre>
<?php endif; ?>

<?php if (isset($backendParams) || isset($queryParams)): ?>
  <h2>Backend Parameters</h2>
  <?php if (isset($queryParams)): ?>
    <h3>Query Parameters</h3>
    <pre><?=$this->escapeHtml(print_r($queryParams, true))?></pre>
  <?php endif; ?>
  <?php if (isset($backendParams)): ?>
    <h3>Non-query Parameters</h3>
    <pre><?=$this->escapeHtml(print_r($backendParams, true))?></pre>
  <?php endif; ?>
<?php endif; ?>
