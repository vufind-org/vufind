<?php
  $values = array_filter(
    [$this->stdValue ?? '', $this->altValue ?? ''],
    fn ($value) => $value !== ''
);
  if ($this->prioritizeAlt) {
    $values = array_reverse($values);
  }
?>
<?php foreach ($values as $value): ?>
  <div>
    <bdi>
      <?=$value?>
    </bdi>
  </div>
<?php endforeach; ?>
