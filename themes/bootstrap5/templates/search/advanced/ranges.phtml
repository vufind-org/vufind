<?php if (isset($this->ranges) && !empty($this->ranges)): ?>
  <?php $params = $this->searchParams($this->searchClassId); ?>
  <?php foreach ($this->ranges as $current): $escField = $this->escapeHtmlAttr($current['field']); ?>
    <?php
      $isDateRange = $current['type'] == 'date';
      $inputType = $isDateRange ? 'number' : 'text';
      $extraInputAttribs = $isDateRange ? 'min="-9999" max="9999"' : '';
    ?>
    <fieldset class="range" id="<?=$escField?>-range-container">
      <legend><?=$this->transEsc($params->getFacetLabel($current['field']))?></legend>
      <input type="hidden" name="<?=$this->escapeHtmlAttr($current['type'])?>range[]" value="<?=$escField?>">
      <div class="date-fields">
        <div class="date-from">
          <label for="<?=$escField?>from" id="<?=$escField?>from-label"><?=$this->transEsc('date_from')?>:</label>
          <input type="<?=$inputType?>" name="<?=$escField?>from" id="<?=$escField?>from" value="<?=isset($current['values'][0]) ? $this->escapeHtmlAttr($current['values'][0]) : ''?>" class="form-control" <?=$extraInputAttribs?>>
        </div>
        <div class="date-to">
          <label for="<?=$escField?>to" id="<?=$escField?>to-label"><?=$this->transEsc('date_to')?>:</label>
          <input type="<?=$inputType?>" name="<?=$escField?>to" id="<?=$escField?>to" value="<?=isset($current['values'][1]) ? $this->escapeHtmlAttr($current['values'][1]) : ''?>" class="form-control" <?=$extraInputAttribs?>>
        </div>
      </div>
      <?php if ($isDateRange): ?>
        <?php
          $this->headScript()->appendFile('vendor/nouislider.min.js');
          $this->headLink()->appendStylesheet('vendor/nouislider.min.css');
          $this->headScript()->appendFile('date_range_slider.js');
          $min = !empty($current['values'][0]) ? min($current['values'][0], 1400) : 1400;
          $future = date('Y', time() + 31536000);
          $max = !empty($current['values'][1]) ? max($future, $current['values'][1]) : $future;
          $low = !empty($current['values'][0]) ? $current['values'][0] : $min;
          $high = !empty($current['values'][1]) ? $current['values'][1] : $max;
          $min = intval($min);
          $max = intval($max);
          $low = intval($low);
          $high = intval($high);
          $sliderOptions = [
            'range' => [
              'min' => $min,
              'max' => $max,
            ],
            'start' => [$low, $high],
          ];
          $sliderAttrs = [
            'id' => $escField . $this->escapeHtmlAttr($current['type']) . 'Slider',
            'class' => 'range-slider',
            'data-options' => json_encode($sliderOptions),
            'data-input-min-id' => $escField . 'from',
            'data-input-max-id' => $escField . 'to',
          ];
        ?>
        <div class="slider-container" aria-hidden="true"><div <?=$this->htmlAttributes($sliderAttrs)?>></div></div>
      <?php endif; ?>
    </fieldset>
  <?php endforeach; ?>
<?php endif; ?>
