  <div class="tree-panel">
    <?=$this->context($this)->renderInContext(
      'RecordTab/hierarchytree.phtml',
      ['treeContext' => 'Collection', 'treePreviewElement' => '#' . $previewAttrs['id'], 'tab' => $this->tab]
    )?>
  </div>
  <div<?=$this->htmlAttributes($previewAttrs)?>>
