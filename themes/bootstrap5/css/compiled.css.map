.star-rating {
  /* Use display:inline-flex to prevent whitespace issues. Alternatively, you can put all the children of .rating-group on a single line. */
  display: inline-flex;
  /* Reset width */
}
.star-rating .rating__icon {
  width: initial;
}
.star-rating {
  /* Show focus ring */
}
.star-rating:focus-within {
  outline: none;
  box-shadow: 0 0 0 var(--bs-focus-ring-width) var(--bs-focus-ring-color);
}
.star-rating .rating__input {
  position: absolute !important;
  left: -9999px !important;
}
.star-rating {
  /* Set icon padding and size */
}
.star-rating .rating__label {
  cursor: pointer;
  /* If you change the left/right padding, update the margin-right property of .rating__label--half as well. */
  padding: 0 0.1em;
  font-size: 1rem;
}
.star-rating {
  /* Add padding and positioning to half star labels */
}
.star-rating .rating__label--half {
  padding-right: 0;
  margin-right: -0.6em;
  z-index: 2;
  /* Display only half of the star and ensure that the remainder cannot be hovered over */
}
.star-rating .rating__label--half .rating__icon--star {
  width: 0.5rem;
  overflow: hidden;
}
.star-rating {
  /* Set default star color */
}
.star-rating .rating__icon--star {
  color: #A56100;
}
.star-rating {
  /* If any input is checked, make its following siblings grey */
}
.star-rating .rating__input:checked ~ .rating__label .rating__icon--star {
  color: #ddd;
}
.star-rating {
  /* Make all stars highlight on rating group hover */
}
.star-rating:not(.readonly):hover .rating__label .rating__icon--star, .star-rating:not(.readonly):hover .rating__label--half .rating__icon--star {
  color: #A56100;
}
.star-rating:not(.readonly) {
  /* Make hovered input's following siblings grey on hover */
}
.star-rating:not(.readonly) .rating__input:hover ~ .rating__label .rating__icon--star,
.star-rating:not(.readonly) .rating__input:hover ~ .rating__label--half .rating__icon--star {
  color: #ddd;
}

