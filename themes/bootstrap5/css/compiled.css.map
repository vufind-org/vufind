  --bs-black: #000;
  --bs-white: #fff;
  --bs-gray: #6c757d;
  --bs-gray-dark: #343a40;
  --bs-gray-100: #f8f9fa;
  --bs-gray-200: #e9ecef;
  --bs-gray-300: #dee2e6;
  --bs-gray-400: #ced4da;
  --bs-gray-500: #adb5bd;
  --bs-gray-600: #6c757d;
  --bs-gray-700: #495057;
  --bs-gray-800: #343a40;
  --bs-gray-900: #212529;
  --bs-primary: #265680;
  --bs-secondary: #6c757d;
  --bs-success: #028302;
  --bs-info: #1C5F74;
  --bs-warning: #A56100;
  --bs-danger: #A41915;
  --bs-light: #f8f9fa;
  --bs-dark: #212529;
  --bs-primary-rgb: 38, 86, 128;
  --bs-secondary-rgb: 108, 117, 125;
  --bs-success-rgb: 2, 131, 2;
  --bs-info-rgb: 28, 95, 116;
  --bs-warning-rgb: 165, 97, 0;
  --bs-danger-rgb: 164, 25, 21;
  --bs-light-rgb: 248, 249, 250;
  --bs-dark-rgb: 33, 37, 41;
  --bs-primary-text-emphasis: rgb(15.2, 34.4, 51.2);
  --bs-secondary-text-emphasis: rgb(43.2, 46.8, 50);
  --bs-success-text-emphasis: rgb(0.8, 52.4, 0.8);
  --bs-info-text-emphasis: rgb(11.2, 38, 46.4);
  --bs-warning-text-emphasis: rgb(66, 38.8, 0);
  --bs-danger-text-emphasis: rgb(65.6, 10, 8.4);
  --bs-light-text-emphasis: #495057;
  --bs-dark-text-emphasis: #495057;
  --bs-primary-bg-subtle: rgb(211.6, 221.2, 229.6);
  --bs-secondary-bg-subtle: rgb(225.6, 227.4, 229);
  --bs-success-bg-subtle: #dff0d8;
  --bs-info-bg-subtle: #d9edf7;
  --bs-warning-bg-subtle: #fcf8e3;
  --bs-danger-bg-subtle: #f2dede;
  --bs-light-bg-subtle: rgb(251.5, 252, 252.5);
  --bs-dark-bg-subtle: #ced4da;
  --bs-primary-border-subtle: rgb(168.2, 187.4, 204.2);
  --bs-secondary-border-subtle: rgb(196.2, 199.8, 203);
  --bs-success-border-subtle: rgb(213.7777777778, 232.9166666667, 197.5833333333);
  --bs-info-border-subtle: rgb(195.9347826087, 234.7934782609, 242.5652173913);
  --bs-warning-border-subtle: rgb(249.5322580645, 234.6478494624, 203.9677419355);
  --bs-danger-border-subtle: rgb(234.7934782609, 203.7065217391, 208.8876811594);
  --bs-light-border-subtle: #e9ecef;
  --bs-dark-border-subtle: #adb5bd;
  --bs-white-rgb: 255, 255, 255;
  --bs-black-rgb: 0, 0, 0;
  --bs-font-sans-serif: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", "Liberation Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
  --bs-font-monospace: SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  --bs-gradient: linear-gradient(180deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0));
  --bs-body-font-family: var(--bs-font-sans-serif);
  --bs-body-font-size: 1rem;
  --bs-body-font-weight: 400;
  --bs-body-line-height: 1.5;
  --bs-body-color: #212529;
  --bs-body-color-rgb: 33, 37, 41;
  --bs-body-bg: #fff;
  --bs-body-bg-rgb: 255, 255, 255;
  --bs-emphasis-color: #000;
  --bs-emphasis-color-rgb: 0, 0, 0;
