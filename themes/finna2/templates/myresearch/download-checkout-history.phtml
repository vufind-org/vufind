<?php
// Initialize checkout history download element
$js = <<<JS
    finna.scriptLoader.load(
      {'finna-checkout-history': 'finna-checkout-history.js'},
      () => {
        if (document.readyState === 'complete') {
          finna.checkoutHistory.init();
        } else {
          document.addEventListener('DOMContentLoaded', () => {
            finna.checkoutHistory.init();
          });
        }
      }
    );
    JS;

echo $this->assetManager()->outputInlineScriptString($js);
