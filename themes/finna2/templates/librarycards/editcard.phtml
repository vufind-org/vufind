<!-- START of: finna - librarycards/editcard.phtml -->
<?php
  // Set up page title:
  $pageTitle = empty($this->card->getId()) ? 'Connect Library Card' : 'Update Card Details';

  // Set up breadcrumbs:
  $this->breadcrumbs()->set($this->translate('Your Account'), $this->url('myresearch-home'))
    ->add($this->translate('Library Cards'), $this->url('librarycards-home'))
    ->add($this->translate($pageTitle), active: true);
?>

<!-- Leftside navigationbar -->
<?= $this->context($this)->renderInContext('myresearch/menu.phtml', ['active' => '']); ?>

<div class="<?=$this->layoutClass('mainbody-myresearch')?>">
  <?=$this->flashmessages()?>

  <?= $this->component('page-title', ['title' => $this->translate($pageTitle)]);?>
  <form class="edit-card-form" method="post" name="<?=empty($this->card->getId()) ? 'newCardForm' : 'editCardForm'?>" autocomplete="off" data-clear-account-cache>
    <input type="hidden" name="id" value="<?=empty($this->card->getId()) ? 'NEW' : $this->escapeHtmlAttr($this->card->getId()) ?>">
    <div class="form-group">
      <label class="form-label" for="card_name"><?=$this->transEsc('Library Card Name'); ?>: <?php if (!$this->translationEmpty('tooltip_library_card_name_html')): ?><?php endif; ?></label><button class="tooltip-button tooltip-library-card-name" type="button" data-bs-toggle="tooltip" data-placement="auto" data-html="true" data-original-title='<?=$this->transEsc('tooltip_library_card_name_html') ?>'><?=$this->icon('info') ?> </button>
      <input id="card_name" class="form-control" type="text" placeholder="<?=$this->transEsc('library_card_name_placeholder'); ?>" name="card_name" value="<?=$this->escapeHtmlAttr($this->cardName == "{$this->target}.{$this->username}" ? $this->username : $this->cardName)?>">
    </div>
    <?php if ($this->targets !== null): ?>
    <div class="form-group">
      <label class="form-label" for="login_target"><?=$this->transEsc('login_target')?>:</label>
      <?php if (count($this->targets) > 1): ?>
        <select id="login_target" name="target" class="form-select">
        <?php foreach ($this->targets as $target): ?>
          <option value="<?=$this->escapeHtmlAttr($target)?>"<?=($target == $this->target ? ' selected="selected"' : '')?>><?=$this->transEsc("source_$target", null, $target)?></option>
        <?php endforeach; ?>
        </select>
      <?php endif; ?>
      <?php if (count($this->targets) == 1): ?>
        <input type="hidden" id="login_target" name="target" class="form-control" value="<?=$this->escapeHtmlAttr($target)?>">
        <p style="padding-top:7px;"><?=$this->transEsc("source_$target", null, $target)?></p>
      <?php endif; ?>
    </div>
    <?php endif; ?>
    <div class="form-group">
      <?php if (null === $this->loginMethod || 'password' === $this->loginMethod): ?>
        <label class="form-label password-login" for="login_username"><?=$this->transEsc('Username')?>:</label>
      <?php endif; ?>
      <?php if (null === $this->loginMethod || 'email' === $this->loginMethod): ?>
        <label class="form-label email-login<?php if (null === $this->loginMethod): ?> hidden<?php endif; ?>" for="login_username"><?=$this->transEsc('Email')?>:</label>
      <?php endif; ?>
      <input id="login_username" type="text" name="username" value="<?=$this->escapeHtmlAttr($this->username)?>" class="form-control">
    </div>
    <?php if (null === $this->loginMethod || 'password' === $this->loginMethod): ?>
      <div class="form-group">
        <label class="form-label" for="login_password"><?=$this->transEsc('Password')?>:</label>
        <input id="login_password" type="password" name="password" value="" placeholder="<?=!empty($this->card->getId()) ? $this->transEscAttr('library_card_edit_password_placeholder') : ''?>" class="form-control">
      </div>
    <?php endif; ?>
    <div class="form-group">
      <input class="btn btn-primary" type="submit" name="submitButton" value="<?=$this->transEscAttr('Save') ?>">
    </div>
    <?php if (empty($this->card->getId())): ?>
      <?php
        $language = $this->layout()->userLang;
        if (!in_array($language, ['fi', 'sv', 'en-gb', 'se'])) {
          $language = 'en-gb';
        }
      ?>
      <?=$this->partial("librarycards/library_card_terms_$language.phtml"); ?>
    <?php endif; ?>
  </form>
  <?php if (!$this->translationEmpty('login_desc_add_library_card_html') && empty($this->card->getId())): ?>
  <div class="login-description">
    <p class="login-info"><?=$this->translate('login_desc_add_library_card_html');?></p>
  </div>
  <?php endif; ?>
</div>

<?php
  if ($this->targets !== null) {
      $methods = json_encode($this->loginMethods);
      $script = <<<EOT
            setupMultiILSLoginFields($methods, 'login_');
          EOT;

      // Inline the script for lightbox compatibility
      echo $this->assetManager()->outputInlineScriptString($script);
  }
?>

<!-- END of: finna - librarycards/editcard.phtml -->
