<?php
  $title = $this->transEsc('ReservationList::All Lists');
  // Set up page title:
  $this->headTitle($title);

  // Set up breadcrumbs:
  $this->breadcrumbs()->set($this->translate('Your Account'), $this->url('myresearch-home'))
    ->add($title, active: true);
?>

<!-- Leftside navigationbar -->
<?= $this->context($this)->renderInContext('myresearch/menu.phtml', ['active' => 'reservationlist']); ?>


<div class="<?=$this->layoutClass('mainbody-myresearch')?> reservation-list-body">
  <h2><?=$title ?></h2>
  <?= $this->flashmessages() ?>
  <ul class="reservations-list-home-ul">
    <?php foreach ($this->listEntities ?? [] as $listEntity): ?>
      <?php
        $listHandler = $this->reservationList($this->auth()->getUserObject())->getListHandler($listEntity->getInstitution(), $listEntity->getListConfigIdentifier());
      ?>
      <li class="reservations-list-home-li">
        <div class="reservation-list-header">
          <div>
            <a href="<?= $this->url('reservationlist-displaylist', ['listId' => $listEntity->getId()])?>"><?= $this->escapeHtml($listEntity->getTitle()) ?></a>
          </div>
          <div class="float-end">
            <?=
              $this->component(
                  'confirm-button',
                  [
                    'buttonLink' => $this->url('reservationlist-deletelist', ['listId' => $listEntity->getId()]),
                    'buttonLabel' => 'delete_list',
                    'confirmLink' => $this->url('reservationlist-deletelist', ['listId' => $listEntity->getId()], ['query' => ['confirm' => 1]]),
                    'header' => 'confirm_delete_list_text',
                    'align' => 'right',
                  ]
              );
            ?>
          </div>
        </div>
        <div class="reservation-list-info">
          <?php // TODO: create a component which handles the defaulting into prettier form ?>
          <div class="location">
            <?php if ($title = $listHandler->getTitle($this->layout()->userLang)): ?>
              <?= $this->escapeHtml($title); ?>
            <?php else: ?>
              <?= $this->transEscWithPrefix('source_', $listHandler->getInstitution()) . ': ' . $this->escapeHtml($listHandler->getIdentifier()); ?>
            <?php endif; ?>
          </div>
          <?php if ($listEntity->getOrdered()): ?>
            <div class="list-ordered list-info">
              <?= $this->transEsc('ReservationList::list_ordered', ['%%date%%' => $listEntity->getOrdered()->format('d.m.Y')])?>
            </div>
          <?php endif; ?>
        </div>
      </li>
      <?php endforeach; ?>
  </ul>
</div>
<div class="mylist-mobile mobile-navigation visible-xs visible-sm hidden-print">
  <ul>
    <li class="sidebar-navigation"><?=$this->icon('sidebar-expand', 'expand-icon') ?><?=$this->icon('sidebar-collapse', 'collapse-icon hidden') ?> <?=$this->transEsc('Your Lists')?></li>
  </ul>
</div>
