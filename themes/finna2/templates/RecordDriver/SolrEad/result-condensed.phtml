                  <a href="<?=$this->escapeHtmlAttr($recordLinker->getUrl("$parentSource|$parentId"))?>"><?=isset($parentTitles[$index]) ? $this->truncate($parentTitles[$index], 180) : ''?></a><?=($index < count($parentIds) - 1 ? ', ' : '')?>
                <?php endforeach; ?>
                <br>
              <?php endif ?>
            <?php endforeach; ?>
            <br>
          <?php endif; ?>
