              <?=$this->icon('hierarchy-tree', 'text-muted') ?>
              <?=$this->transEsc($treeLinkText)?><?php if (count($trees) > 1): ?>: <?=$this->escapeHtml($hierarchyTitle)?><?php endif; ?>
