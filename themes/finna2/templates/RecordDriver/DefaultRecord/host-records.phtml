<?php foreach ($hostRecords as $i => $hostRecord): ?>
  <?php
    $label = $hostRecord['title'] ?: $hostRecord['mainHeading'];
    $link = '';
    if ($hostRecord['id']) {
      $link = $this->recordLinker()->getUrl($hostRecord['sourceId'] . '|' . $hostRecord['id']);
    } elseif ($linkingId = $hostRecord['linkingId']) {
      $link = $this->recordLinker()->related(['type' => 'linkingId', 'value' => $linkingId]);
    } else {
      $link = $this->record($this->driver)->getLink('title', $hostRecord['title']);
    }
  ?>
  <?php if ($link): ?>
    <div><a href="<?=$this->escapeHtmlAttr($link)?>"><?=$label?></a>  <?=$this->escapeHtml($hostRecord['reference']); ?></div>
  <?php else: ?>
    <div><?=$this->escapeHtml($hostRecord['reference']); ?></div>
  <?php endif; ?>
<?php endforeach; ?>
