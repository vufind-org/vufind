              <?=$this->record($this->driver)->getTitleHtml()?><span class="visually-hidden"> <?=$this->transEsc('To the record')?></span>
            </a>
          </h2>
          <?php if ($uniformTitles = $this->driver->tryMethod('getUniformTitles')): ?>
            <div class="result-uniform-titles">
