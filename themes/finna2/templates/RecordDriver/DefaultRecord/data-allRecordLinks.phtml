<?php //Don't add START and END comments ?>
<?php if (!empty($data)): ?>
  <?php
    $allLinks = $data;
    if ($useLinkTitles = isset($data[0]['title'])) {
      $allLinks = [];
      foreach ($data as $link) {
        $allLinks[$link['title']][] = $link;
      }
    }
  ?>
  <?php if ($useLinkTitles):?>
    <?php foreach ($allLinks as $title => $links): ?>
      <tr class="recordLinks">
        <th><?=$this->transEsc($title);?></th>
        <?php $class = isset($links[0]['isCollection']) ? 'contained-in' : ''; ?>
        <td>
          <?php foreach ($links as $link): ?>
            <div class="<?=$class?>">
              <a href="<?=$this->escapeHtmlAttr($this->recordLinker()->related($link['link'], $this->driver->getSourceIdentifier()));?>"><?=$this->escapeHtml($link['value'] ?: $this->translate($title));?></a><?php if (isset($link['detail'])): ?> (<?=$this->escapeHtml($link['detail'])?>)<?php endif; ?><?php if (!empty($link['misc'])): ?> / <?=$this->escapeHtml($link['misc'])?><?php endif; ?>
            </div>
          <?php endforeach; ?>
        </td>
      </tr>
    <?php endforeach; ?>
  <?php else:?>
    <div class="truncate-field">
      <?php foreach ($allLinks as $link): ?>
        <a href="<?=$this->escapeHtmlAttr($this->recordLinker()->related($link['link'], $this->driver->getSourceIdentifier()));?>"><?=$this->escapeHtml($link['value'])?></a><?php if (isset($link['detail'])): ?> (<?=$this->escapeHtml($link['detail'])?>)<?php endif; ?>
        <br>
      <?php endforeach; ?>
    </div>
  <?php endif?>
<?php endif; ?>
