<!-- START of: finna - search/searchTabs.phtml -->
<?php
  $isManyTabs = (count($searchTabs) > 2);
  $module = $this->layout()->templateDir;
  $hasSelectedTab = false;
?>
<?php if (!$isManyTabs): ?>
  <div class="tabs-table">
<?php endif; ?>
<?php if (!empty($searchTabs)): ?>
  <div role="navigation" aria-label="<?=$this->transEscAttr('Search Tabs')?>">
    <ul class="nav nav-tabs <?=$isManyTabs ? ' many-tabs hidden-xs' : '';?>">
      <?php foreach ($searchTabs as $tab): ?>
        <?php if ($tab['selected']) {
          $this->layout()->currentTabId = $tab['id'];
          $hasSelectedTab = true;
        }
        $toggletipKeyHtml = 'tooltip_' . $tab['label'] . '_html';
        if ($this->layout()->templateName !== 'advanced' && !$this->translationEmpty($toggletipKeyHtml)) {
          $toggletip = [
            'icon' => 'help',
            'ariaLabel' => $this->translate('Help') . ' - ' . $this->translate($tab['label']),
            'contentHtml' => $this->translate($toggletipKeyHtml),
            'class' => 'tooltip-' . $tab['label'], // for back-compatibility
          ];
        } else {
          $toggletip = '';
        }
        ?>
        <li class="nav-item <?=$tab['selected'] ? 'active' : 'hidden-print'?><?=$toggletip ? ' with-tooltip' : ''?>">
          <a class="nav-link<?=$tab['selected'] ? ' active' : ''?>" <?=$tab['selected'] ? 'aria-current="true"' : 'href="' . $this->escapeHtmlAttr($tab['url']) . '"' ?>>
            <?=$this->transEsc($tab['label']); ?>
          </a>
          <?php if ($toggletip): ?>
            <?=$this->component('finna-toggletip', $toggletip)?>
          <?php endif; ?>
        </li>
      <?php endforeach; ?>
      <?php if (!$hasSelectedTab && !$this->translationEmpty('temporary_search_tab_title')): ?>
        <li class="nav-item active">
          <a class="nav-link active"><?=$this->transEsc('temporary_search_tab_title')?></a>
        </li>
      <?php endif; ?>
    </ul>
    <?php if (!$this->translationEmpty("search_tab_tip_{$module}_html")) :?>
      <div class="search-tab-tip">
        <?=$this->translate("search_tab_tip_{$module}_html");?>
      </div>
    <?php endif; ?>
    <div class="mobile-main-tabs <?=count($searchTabs) > 2 ? 'visible-xs' : 'hidden';?>">
      <div class="dropdown visible-xs">
        <?php foreach ($searchTabs as $tab): ?>
          <?php if ($tab['selected']): ?>
            <div class="dropdown-toggle clearfix" data-bs-toggle="dropdown" aria-expanded="false">
              <div class="tab-title"><?=$this->transEsc($tab['label']); ?></div>
              <div class="more"><?=$this->transEsc('More');?><?=$this->icon('menu-open') ?> </div>
            </div>
          <?php endif; ?>
        <?php endforeach; ?>
        <ul class="dropdown-menu" role="menu">
          <?php foreach ($searchTabs as $tab): ?>
            <?php if ($tab['selected']) {
              $this->layout()->currentTabId = $tab['id'];
            } ?>
            <li class="<?=$tab['selected'] ? 'active' : ''?>">
              <a class="dropdown-item" role="menuitem" <?=$tab['selected'] ? 'aria-current="true"' : 'href="' . $this->escapeHtmlAttr($tab['url']) . '"' ?>><?=$this->transEsc($tab['label']); ?></a>
            </li>
          <?php endforeach; ?>
        </ul>
      </div>
    </div>
  </div>
<?php endif; ?>
<?php if (!$isManyTabs): ?>
  </div>
<?php endif; ?>
<!-- END of: finna - search/searchTabs.phtml -->
