<?php
  /**
   * Tabbed navigation bar that will also show the active tab's children.
   *
   * Uses the following components:
   * - finna-nav
   *
   * @param ?string   ariaCurrent  See finna-nav
   * @param ?string   ariaLabel    Value for aria-label attribute
   * @param ?iterable attributes   Additional attributes
   * @param ?array    items        See finna-nav
   *
   * Supported variations using CSS classes:
   * - finna-tabs-nav-lg
   *     Larger variation
   */
  $__attributes = $this->htmlAttributes($attributes ?? []);
  if (isset($ariaLabel)) {
    $__attributes['aria-label'] = $ariaLabel;
  }
?>
<nav<?= $__attributes->add('class', ['finna-tabs-nav', 'clearfix']) ?>>
  <?php
    $__navAttributes = $this->htmlAttributes(['class' => 'finna-nav-tabs']);
    if ($__attributes->hasValue('class', 'finna-tabs-nav-lg')) {
      $__navAttributes->add('class', 'finna-nav-lg');
    }
  ?>
  <?= $this->component('finna-nav', [
      'ariaCurrent' => $ariaCurrent ?? null,
      'attributes' => $__navAttributes,
      'items' => $items ?? [],
      'renderChildren' => 'simple',
    ]); ?>
</nav>
