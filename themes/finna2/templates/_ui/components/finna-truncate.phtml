<?php
  /**
   * A truncation component that supports both element-based and height-based
   * truncation. Processes Finna default values and provided parameters to build a
   * data-truncate attribute for truncate.js.
   *
   * @param ?iterable attributes     Additional attributes
   * @param ?string   btnClass       Button class
   * @param ?string   content        Content
   * @param ?string   element        Used for element-based truncation. If not set
   *                                 the default is to use height-based truncation.
   * @param ?bool     inPlaceToggle  Use in-place toggle?
   * @param ?string   label          Label
   * @param ?string   labelIcons     Label icons placement. Defaults to 'after'.
   * @param ?string   lessIcon       Show less icon
   * @param ?string   lessLabel      Show less label. Defaults to 'show_less'.
   * @param ?string   moreIcon       Show more icon
   * @param ?string   moreLabel      Show more label. Defaults to 'show_more'.
   * @param ?int      rows           Number of rows to show. Defaults to 0.
   * @param ?int      topToggle      Use top toggle on this row
   * @param ?string   wrapperClass   Wrapper class. Defaults to
   *                                 'finna-truncate-btn-wrapper-default'.
   * @param ?string   wrapperTagname Wrapper tag name.
   */
  $__attributes = $this->htmlAttributes($attributes ?? []);
  $__truncateSettings = [];
  if (isset($btnClass)) {
    $__truncateSettings['btn-class'] = $btnClass;
  }
  if (isset($element)) {
    $__truncateSettings['element'] = $element;
    $__attributes->add('class', 'element-based');
  } else {
    $__attributes->add('class', 'height-based');
  }
  if (isset($inPlaceToggle)) {
    $__truncateSettings['in-place-toggle'] = $inPlaceToggle;
  }
  if (isset($label)) {
    $__truncateSettings['label'] = $this->transEsc($label);
  }
  if (isset($labelIcons)) {
    $__truncateSettings['label-icons'] = $labelIcons;
  } else {
      // Default to legacy Finna truncate more and less links appearance.
      $__truncateSettings['label-icons'] = 'after';
  }
  if (isset($lessIcon)) {
    $__truncateSettings['less-icon'] = $lessIcon;
  }
  if (isset($lessLabel)) {
    $__truncateSettings['less-label'] = $this->transEsc($lessLabel);
  } elseif (!isset($label)) {
      // Default to legacy Finna truncate more and less links appearance.
      $__truncateSettings['less-label'] = $this->transEsc('show_less');
  }
  if (isset($moreIcon)) {
    $__truncateSettings['more-icon'] = $moreIcon;
  }
  if (isset($moreLabel)) {
    $__truncateSettings['more-label'] = $this->transEsc($moreLabel);
  } elseif (!isset($label)) {
      // Default to legacy Finna truncate more and less links appearance.
      $__truncateSettings['more-label'] = $this->transEsc('show_more');
  }
  if (isset($rows)) {
    $__truncateSettings['rows'] = $rows;
  } else {
    // Default to legacy Finna truncate more and less links appearance.
    $__truncateSettings['rows'] = 0;
  }
  if (isset($topToggle)) {
    $__truncateSettings['top-toggle'] = $topToggle;
  }
  if (isset($wrapperClass)) {
    $__truncateSettings['wrapper-class'] = $wrapperClass;
  } else {
    // Default to legacy Finna truncate more and less links appearance.
    $__truncateSettings['wrapper-class'] = 'finna-truncate-btn-wrapper-default';
  }
  if (isset($wrapperTagname)) {
    $__truncateSettings['wrapper-tagname'] = $wrapperTagname;
  }
  if (!empty($__truncateSettings)) {
    $__attributes['data-truncate'] = json_encode($__truncateSettings);
  }
?>
<div<?= $__attributes->add('class', 'finna-truncate') ?>>
  <?= $content ?? '' ?>
</div>
