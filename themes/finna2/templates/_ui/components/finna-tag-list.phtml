<?php
  /**
   * Component for displaying a list of tags with an optional title.
   *
   * @param ?iterable attributes     Additional attributes
   * @param ?bool     htmlItems      Are the items plain text or HTML? Defaults to
   *                                 false.
   * @param string[]  items          Array of plain text or HTML items
   * @param ?string   title          Title
   * @param ?bool     translateItems Should the items be translated? Defaults to
   *                                 true. Has no effect if htmlItems is true.
   */
  $__attributes = $this->htmlAttributes($attributes ?? []);
  $__htmlItems = $htmlItems ?? false;
  $__translateItems = $translateItems ?? true;
  $__listTag = isset($title) ? 'dl' : 'ul';
  $__itemTag = isset($title) ? 'dd' : 'li';
?>
<<?= $__listTag ?><?= $__attributes->add('class', 'finna-tag-list') ?>>
  <?php if (isset($title)): ?>
    <dt><?= $this->transEsc($title) ?></dt>
  <?php endif; ?>
  <?php foreach ($items ?? [] as $__item): ?>
    <?php
      if (!$__htmlItems && $__translateItems) {
        $__item = $this->transEsc($__item);
      }
    ?>
    <<?= $__itemTag ?>><?= $__item ?></<?= $__itemTag ?>>
  <?php endforeach; ?>
</<?= $__listTag ?>>
