<?php $holdings = $this->tab->getHoldings(); ?>
<?php if (isset($holdings->diagnostic->message)): ?>
  <p><?=$this->escapeHtml($holdings->diagnostic->message)?></p>
<?php elseif ($holdings && count($holdings) > 0): ?>
