<!-- finc: cart - contents -->
<?php
/**
* origin: vufind/BS3
* called by view helper/controller:
* usage:
* modified for finc:
 * removes label here - we use it in record/checkbox already
 * adds aria-describedby + 'lang'
 * collects citation data
 * adds aria-live and uses p for alerts
 *
*  TODO:
 * it would be useful to add a switch that makes checkbox IDs unique for both, result list AND cart. As it is, cart and result list entries get the same IDs which results in W3C errors and is most likely not accessible (see also RecordDriver/.../list-entry.phtml); cart entries could get the prefix 'cart_', for example.
 *
 * configured in: {}
 */
?>
<?php $records = $this->cart()->getRecordDetails(); if (!empty($records)): ?>
  <hr>
  <ul class="list-unstyled">
  <?php foreach ($records as $i => $record): ?>
    <li>
      <div class="checkbox">
        <?php /* removes label here - we use it in record/checkbox already - CK
        <label> */ ?>
        <?=$this->record($record)->getCheckbox('cart')?>
        <?php /* finc: adds aria-describedby + 'lang' - CK */ ?>
        <?php $describedById = $record->getSourceIdentifier() . '|' . $record->getUniqueId(); ?>
        <a id="<?=$describedById?>" title="<?=$this->transEscAttr('View Record')?>" href="<?=$this->escapeHtmlAttr($this->recordLinker()->getUrl($record))?>" data-lightbox-ignore lang=""><?=$this->escapeHtml($record->getBreadcrumb())?>
          <?php
          // finc-specific: Collect citation data:
          $helper = $this->citation($record);
          $recordtype = $record->getRecordType();
          ?>
          <?php if ($recordtype == 'ai'): ?>
            <?=$helper->getCitation('APAAI')?>
          <?php else: ?>
            <?=$helper->getCitation('APA')?>
          <?php endif; ?>
        </a>
      <?php /* </label> */ ?>
      </div>
    </li>
  <?php endforeach; ?>
  </ul>
<?php else: ?>
<?php /* finc: adds aria-live and uses p for alerts */ ?>
  <p class="alert alert-info" aria-live="polite"><?=$this->transEsc('bookbag_is_empty')?>.</p>
<?php endif; ?>
<!-- finc: cart - contents - END -->
