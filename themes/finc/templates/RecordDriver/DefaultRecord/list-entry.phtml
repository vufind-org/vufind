                <?php endforeach; ?>
              <?php endif; ?>
            <?php endif; ?>
          <br>

          <?=$this->record($this->driver)->getFormatList() ?>

          <?php if (!$openUrlActive && empty($urls) && $this->driver->supportsAjaxStatus()): ?>
            <span class="status ajax-availability hidden"><?=$this->transEsc('loading_ellipsis')?></span>
