<!-- finc: notifications - maintenance -->
<?php
  /**
   * origin: vufind/finc
   *
   * called by view header.phtml de_zi4:
   *
   * usage:
   * show warning messages like maintenance depending on a timeframe set in config.ini
   *
   * created for finc: specific implemented for finc #26514
   *
   * configured in: {}
   * The message content needs to be edited in the language ini files under 'maintenance_warning = '
   */
?>
<?php
    // refs #26514 display maintenance hint
    $siteConfig = $this->config()->get('config')->Site;

    if ($siteConfig->maintenance_start && $siteConfig->maintenance_end) {

        $currentDate = new \DateTime();
        $startDate = new \DateTime($siteConfig->maintenance_start);
        $endDate = new \DateTime($siteConfig->maintenance_end);
        $endDate->setTime(23, 59, 59); // include last day

        if ($currentDate >= $startDate && $currentDate <= $endDate) {
            ?>
          <aside
            role="alert"
            tabindex="0"
            aria-labelledby="maintenance-warning"
            class="maintenance-aside margin-l-xs margin-r-xs"
          >
            <p id="maintenance-warning">
                <?= $this->translate('maintenance_warning') ?>
            </p>
          </aside>
            <?php
        }
    }
?>
<!-- finc: notifications - maintenance - END -->
