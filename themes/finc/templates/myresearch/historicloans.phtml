  <?=$this->flashmessages()?>

  <?=$this->context($this)->renderInContext('librarycards/selectcard.phtml', ['user' => $this->auth()->isLoggedIn()]); ?>

  <?php /* finc: uses '$this->recordList' instead of '$this->transactions' #23952 */ ?>
