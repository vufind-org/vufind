<?php
/**
* origin: vufind/BS3
* called by view helper/controller:
* usage:
* modified for finc:
 * does not use 'Your Account' offcanvas-toggler here #22293
 * uses offcanvas-toggler-myresearch #22293
 * uses h1 instead of h2
 * Removes part of template responsible for rendering user data from VuFind
