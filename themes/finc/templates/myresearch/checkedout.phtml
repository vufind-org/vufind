                <br>
              <?php endif; ?>
              <?php if ($this->displayItemBarcode && !empty($ilsDetails['barcode'])): ?>
                <strong><?=$this->transEsc('Barcode')?>:</strong> <?=$this->escapeHtml($ilsDetails['barcode'])?>
                <br>
              <?php endif; ?>

