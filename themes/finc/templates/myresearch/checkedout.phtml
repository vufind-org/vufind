                  <?php if (isset($ilsDetails['dueStatus']) && $ilsDetails['dueStatus'] == "overdue"): ?>
                    <p class="alert alert-danger" aria-live="polite"><?=$this->transEsc("renew_item_overdue")?></p>
                  <?php elseif (isset($ilsDetails['dueStatus']) && $ilsDetails['dueStatus'] == "due"): ?>
                    <p class="alert alert-info" aria-live="polite"><?=$this->transEsc("renew_item_due")?></p>
                  <?php endif; ?>
